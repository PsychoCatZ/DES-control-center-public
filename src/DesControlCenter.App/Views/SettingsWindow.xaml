<Window x:Class="DesControlCenter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — DES Control Center" Height="560" Width="760" Icon="/Tray/Icons/ok.ico" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16" Background="{DynamicResource BackgroundBrush}">
        <Button DockPanel.Dock="Bottom" Content="Сохранить и применить" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" Margin="0,12,0,0" Command="{Binding SaveCommand}" />

        <TabControl DockPanel.Dock="Top">

            <TabItem Header="Проекты">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="+ Добавить" Command="{Binding AddProjectCommand}" Margin="0,0,6,0" />
                            <Button Content="Удалить" Command="{Binding RemoveProjectCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" />
                    </DockPanel>

                    <StackPanel Grid.Column="2" DataContext="{Binding SelectedProject}">
                        <TextBlock Text="Название" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                        <TextBlock Text="Описание" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Серверы">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="+ Добавить" Command="{Binding AddServerCommand}" Margin="0,0,6,0" />
                            <Button Content="Удалить" Command="{Binding RemoveServerCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" DisplayMemberPath="Name" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" DataContext="{Binding SelectedServer}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Имя" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                            <TextBlock Text="Host / IP" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SSH порт" Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding SshPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Пользователь" Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding SshUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Путь к приватному ключу (необязательно)" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding SshIdentityFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                            <TextBlock Text="Alias из ~/.ssh/config (необязательно, приоритетнее полей выше)" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding SshConfigAlias, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Путь для проверки диска" Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding DiskPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Интервал опроса, сек" Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Проект" Style="{StaticResource MutedTextStyle}" />
                            <ComboBox ItemsSource="{Binding DataContext.Projects, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding ProjectId}" Margin="0,2,0,10" />

                            <CheckBox Content="Включён" IsChecked="{Binding Enabled}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Сайты">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="+ Добавить" Command="{Binding AddWebsiteCommand}" Margin="0,0,6,0" />
                            <Button Content="Удалить" Command="{Binding RemoveWebsiteCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Websites}" SelectedItem="{Binding SelectedWebsite}" DisplayMemberPath="Name" />
                    </DockPanel>

                    <StackPanel Grid.Column="2" DataContext="{Binding SelectedWebsite}">
                        <TextBlock Text="Название" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                        <TextBlock Text="URL" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                        <TextBlock Text="Категория (бейдж в интерфейсе, например «Сайт» или «AI-сервис»)" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                        <TextBlock Text="Сервер (оставь пустым для External Services — сайт не наш, снаружи)" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox ItemsSource="{Binding DataContext.Servers, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding ServerId}" Margin="0,2,0,10" />

                        <TextBlock Text="Протокол десктоп-приложения (напр. «tg», «whatsapp» — без ://; пусто, если нет)" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding DesktopProtocol, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                        <TextBlock Text="Имя приложения в Пуск (напр. «ChatGPT», «Gemini» — если протокола нет)" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding DesktopAppName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Порог SSL, дней" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding SslWarningDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Интервал опроса, сек" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Проект" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox ItemsSource="{Binding DataContext.Projects, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding ProjectId}" Margin="0,2,0,10" />

                        <CheckBox Content="Включён" IsChecked="{Binding Enabled}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Сервисы">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="+ Добавить" Command="{Binding AddServiceCommand}" Margin="0,0,6,0" />
                            <Button Content="Удалить" Command="{Binding RemoveServiceCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" DisplayMemberPath="DisplayName" />
                    </DockPanel>

                    <StackPanel Grid.Column="2" DataContext="{Binding SelectedService}">
                        <TextBlock Text="Название (для человека)" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                        <TextBlock Text="systemd unit (например notifier.service) или имя Docker-контейнера" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />

                        <CheckBox Content="Это Docker-контейнер, а не systemd-служба" IsChecked="{Binding IsDocker}" Margin="0,0,0,4" />
                        <CheckBox Content="Docker запускать через sudo (если вход не под root)" IsChecked="{Binding UseSudo}" Margin="0,0,0,10" />

                        <TextBlock Text="Категория (бейдж в интерфейсе, например «Telegram-бот»)" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                        <TextBlock Text="Сервер" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox ItemsSource="{Binding DataContext.Servers, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding ServerId}" Margin="0,2,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Интервал опроса, сек" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Проект" Style="{StaticResource MutedTextStyle}" />
                                <ComboBox ItemsSource="{Binding DataContext.Projects, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding ProjectId}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Включён" IsChecked="{Binding Enabled}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="VPN">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="+ Добавить" Command="{Binding AddVpnCommand}" Margin="0,0,6,0" />
                            <Button Content="Удалить" Command="{Binding RemoveVpnCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Vpns}" SelectedItem="{Binding SelectedVpn}" DisplayMemberPath="DisplayName" />
                    </DockPanel>

                    <StackPanel Grid.Column="2" DataContext="{Binding SelectedVpn}">
                        <TextBlock Text="Название (для человека)" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                        <TextBlock Text="Имя Docker-контейнера (обычно amnezia-awg2)" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding ContainerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                        <TextBlock Text="Сервер" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox ItemsSource="{Binding DataContext.Servers, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding ServerId}" Margin="0,2,0,10" />

                        <TextBlock Text="Интервал опроса, сек" Style="{StaticResource MutedTextStyle}" />
                        <TextBox Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                        <CheckBox Content="SSH-пользователь не в группе docker — использовать sudo" IsChecked="{Binding UseSudo}" Margin="0,4,0,10" />
                        <CheckBox Content="Включён" IsChecked="{Binding Enabled}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Приложение">
                <StackPanel Margin="0,16,0,0">
                    <CheckBox Content="Запускать вместе с Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10" />
                    <CheckBox Content="Сворачивать в трей при закрытии окна" IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,0,0,10" />
                    <CheckBox Content="Показывать Windows-уведомления" IsChecked="{Binding ShowNotifications}" />
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
