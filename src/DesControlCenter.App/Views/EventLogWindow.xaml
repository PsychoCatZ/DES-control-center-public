<Window x:Class="DesControlCenter.App.Views.EventLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал событий" Height="520" Width="720" Icon="/Tray/Icons/ok.ico" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16" Background="{DynamicResource BackgroundBrush}">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="120" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="120" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                <TextBlock Text="Проект:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding SelectedProject}" Width="140" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                <TextBlock Text="Тип ресурса:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding ResourceKindOptions}" SelectedItem="{Binding SelectedResourceKind}" Width="110" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                <TextBlock Text="Тип события:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding EventKindOptions}" SelectedItem="{Binding SelectedEventKind}" Width="130" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="140" />
            </StackPanel>
            <Button Content="Применить" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" Margin="0,0,0,6" />
        </WrapPanel>

        <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время" Binding="{Binding TimestampUtc, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="150" />
                <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="110" />
                <DataGridTextColumn Header="Ресурс" Binding="{Binding ResourceName}" Width="150" />
                <DataGridTextColumn Header="Тип" Binding="{Binding ResourceKind}" Width="80" />
                <DataGridTextColumn Header="Событие" Binding="{Binding EventKind}" Width="110" />
                <DataGridTextColumn Header="Переход" Binding="{Binding OldState}" Width="90" />
                <DataGridTextColumn Header="→" Binding="{Binding NewState}" Width="90" />
                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
